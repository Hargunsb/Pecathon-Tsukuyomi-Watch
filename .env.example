# GEMINI_API_KEY: Optional/Recommended for the AI Astronomy Assistant (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NASA_API_KEY: Optional API key for NASA Open APIs (APOD, DONKI).
# Defaults to NASA's public "DEMO_KEY" on the server if omitted.
NASA_API_KEY="DEMO_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

